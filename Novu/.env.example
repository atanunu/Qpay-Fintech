# Documentation contract only. Populate secure environment-specific configuration after qualification.
# No live hostname, credential, sender or upstream version is selected by this file.
NODE_ENV=production
NOVU_API_URL=https://novu-api.example.invalid
NOVU_BRIDGE_URL=https://novu-bridge.example.invalid/api/novu
NOVU_SOCKET_URL=https://novu-socket.example.invalid
NOVU_DASHBOARD_URL=https://novu-admin.example.invalid
NOVU_SECRET_KEY=
JWT_SECRET=
STORE_ENCRYPTION_KEY=
MONGO_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_CACHE_SERVICE_HOST=
# Confirm variable support in the selected upstream release.
DISABLE_USER_REGISTRATION=true
NOVU_TELEMETRY=false
# Allow only the actual private bridge hostname, never a broad private range.
NOVU_SAFE_OUTBOUND_ALLOW=
QPAY_NOTIFICATION_POLICY_URL=
QPAY_NOTIFICATION_POLICY_TOKEN=
QPAY_EMAIL_PROVIDER=
QPAY_EMAIL_FROM=
QPAY_EMAIL_REPLY_TO=
QPAY_EMAIL_CUSTOMER_ORIGIN=https://app.example.invalid
QPAY_EMAIL_STAFF_ORIGIN=https://admin.example.invalid
QPAY_EMAIL_BUSINESS_ORIGIN=https://business.example.invalid
QPAY_EMAIL_LEGAL_NAME=
QPAY_EMAIL_POSTAL_ADDRESS=
QPAY_NOTIFICATION_RELEASE=
