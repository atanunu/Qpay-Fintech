# Names only. Use scripts/local_config.py for isolated local development.
QPF_ENV=staging
DATABASE_URL=postgres://runtime-user:replace-outside-git@postgres.internal:5432/qpf?sslmode=verify-full
AUTH_PEPPER=
DATA_KEY_ID=v1
DATA_KEYS=
WEB_ORIGINS=https://app.example.invalid,https://admin.example.invalid
HTTP_ADDR=:8080
EXECUTION_MODE=off
ACCOUNT_POLICY_ACCEPTED=false
QPAY_CONTRACT_ACCEPTED=false
QPAY_URL=
QPAY_APPLICATION_ID=
QPAY_API_KEY=
QPAY_API_SECRET=
QPAY_ENVIRONMENT=sandbox
QPAY_SENDER_ACCOUNT=
QPAY_SENDER_NAME=
QPAY_SENDER_BANK=
NOTIFICATION_MODE=off
NOTIFICATION_POLICY_KEY=
NOVU_API_URL=
NOVU_SECRET_KEY=
NOVU_WORKFLOW_ALLOWLIST=

# Optional verified integrations. Off until explicitly configured and accepted.
PASSKEY_RP_ID=
PRIVATE_UPLOAD_MODE=off
PRIVATE_UPLOAD_ROOT=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=
PRIVATE_S3_ACCESS_KEY=
PRIVATE_S3_SECRET_KEY=
CLAMD_SOCKET=
FUNDING_MODE=off
FUNDING_CALLBACK_KEY=
SCHEDULED_INTERNAL_ACCEPTED=false

# Separate staff browser origin; required to permit non-local staff browser requests.
ADMIN_ORIGINS=https://admin.example.invalid
